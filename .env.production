# ===================================================================
# FREE TIER PRODUCTION ENVIRONMENT CONFIGURATION
# Support Triage Agent - AWS ap-southeast-2 Deployment
# ===================================================================
# IMPORTANT: Never commit this file to git (.env.production is in .gitignore)
# ===================================================================

# ==== AWS CONFIGURATION ====
AWS_REGION=ap-southeast-2
AWS_ACCOUNT_ID=YOUR_AWS_ACCOUNT_ID
AWS_PROFILE=support-triage

# ==== APPLICATION ENVIRONMENT ====
ENVIRONMENT=production
APP_NAME=support-triage-agent
VERSION=v1.0
DEBUG=false
LOG_LEVEL=INFO

# ==== DATABASE CONFIGURATION (RDS PostgreSQL - FREE TIER) ====
# Free Tier: 12 months free with db.t3.micro, 20 GB storage
DB_ENGINE=postgresql
DB_VERSION=15
DB_INSTANCE_CLASS=db.t3.micro        # FREE for 12 months
DB_STORAGE_GB=20                     # FREE tier limit (20 GB)
DB_STORAGE_TYPE=gp2                  # gp3 costs more
DB_MULTI_AZ=false                    # NOT included in free tier
DB_BACKUP_RETENTION_DAYS=7           # Keep backups short (costs storage)
DB_PREFERRED_BACKUP_WINDOW=03:00-04:00
DB_MAINTENANCE_WINDOW=mon:04:00-mon:05:00
DB_ENABLE_CLOUDWATCH_LOGS=false      # Costs money beyond free tier
DB_ENABLE_PERFORMANCE_INSIGHTS=false # Costs money

# Database credentials are managed by AWS Secrets Manager (set by Terraform)
# DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD set automatically

# ==== REDIS/ELASTICACHE CONFIGURATION (MINIMAL COST) ====
# Free Tier: 750 hours/month cache.t3.micro (minimal tier)
# After free tier: ~$8/month for 1 node
CACHE_ENGINE=redis
CACHE_VERSION=7.0
CACHE_NODE_TYPE=cache.t3.micro       # Minimal tier
CACHE_NUM_NODES=1                    # Single node (no replication)
CACHE_MULTI_AZ=false                 # Not free
CACHE_AUTOMATIC_FAILOVER=false       # Not free
CACHE_AUTO_MINOR_VERSION_UPGRADE=true
CACHE_PARAMETER_GROUP_FAMILY=redis7.0

# Redis credentials managed by AWS Secrets Manager (set by Terraform)

# ==== ECS FARGATE CONFIGURATION (FREE TIER) ====
# Free Tier: 750 hours/month at 256 vCPU + 512 MB memory
# After free tier: ~$30/month for 1 task continuous
ECS_CLUSTER_NAME=support-triage-free
ECS_CONTAINER_CPU=256                # 256 vCPU fits free tier (not 512)
ECS_CONTAINER_MEMORY=512             # 512 MB fits free tier (not 1024)
ECS_DESIRED_COUNT=1                  # Single task (no scaling)
ECS_ENABLE_CONTAINER_INSIGHTS=false  # Costs money
ECS_LAUNCH_TYPE=FARGATE
ECS_PLATFORM_VERSION=LATEST
ECS_TASK_REVISION=1

# ==== APPLICATION PORTS & HEALTH ====
API_PORT=8000
WORKER_CONCURRENCY=2                 # Limited by 512 MB memory
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5

# ==== LOAD BALANCER CONFIGURATION (NETWORK LB - CHEAPER) ====
# ALB ~$16/month, NLB ~$5/month
# Using Network LB for cost savings and TCP simplicity
ALB_TYPE=nlb                         # Network Load Balancer
ALB_NAME=support-triage-nlb
ALB_SCHEME=internet-facing
ALB_PORT=443
ALB_PROTOCOL=TLS
ALB_ENABLE_DELETION_PROTECTION=true
ALB_ENABLE_CROSS_ZONE=true
ALB_ENABLE_ACCESS_LOGS=false         # Costs money
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_PROTOCOL=HTTP
HEALTH_CHECK_INTERVAL_SECONDS=30
HEALTH_CHECK_TIMEOUT_SECONDS=5
HEALTHY_THRESHOLD_COUNT=2
UNHEALTHY_THRESHOLD_COUNT=3

# ==== SSL/TLS CERTIFICATE ====
# Use AWS Certificate Manager (free public certificates)
# Create certificate in ap-southeast-2 region
# SSL_CERTIFICATE_ARN=arn:aws:acm:ap-southeast-2:ACCOUNT_ID:certificate/ID
# Set this after creating certificate in ACM console
SSL_CERTIFICATE_ARN=

# ==== VPC CONFIGURATION ====
VPC_CIDR=10.0.0.0/16
VPC_ENABLE_DNS_HOSTNAMES=true
VPC_ENABLE_DNS_SUPPORT=true
VPC_ENABLE_NAT_GATEWAY=true          # Required for ECS private subnets

# ==== SUBNET CONFIGURATION (SINGLE AZ FOR FREE TIER) ====
# Free tier is single AZ only
# Using ap-southeast-2a (Sydney)
AVAILABILITY_ZONE=ap-southeast-2a
PUBLIC_SUBNET_CIDR=10.0.101.0/24     # ALB subnet
PRIVATE_SUBNET_CIDR=10.0.1.0/24      # ECS/RDS subnet

# ==== SECURITY CONFIGURATION ====
ENABLE_WAF=false                     # Costs money
ENABLE_SHIELD_ADVANCED=false         # Not needed for free tier
ENABLE_NETWORK_ACL=true
ENABLE_ENCRYPTION_AT_REST=true
ENABLE_ENCRYPTION_IN_TRANSIT=true

# ==== MONITORING & ALERTS ====
ENABLE_CLOUDWATCH_MONITORING=true    # Free up to 5 GB logs/month
ENABLE_ENHANCED_MONITORING=false     # Costs money
MONITORING_RETENTION_DAYS=7          # Keep logs short (costs storage)
ALERT_EMAIL=your-email@example.com
ALERT_SNS_TOPIC_NAME=support-triage-alerts
CLOUDWATCH_LOG_RETENTION_DAYS=7

# ==== FEATURE FLAGS ====
FEATURE_AI_TRIAGE=true
FEATURE_SENTIMENT_ANALYSIS=true
FEATURE_ESCALATION_WORKFLOWS=true
FEATURE_SLA_TRACKING=true

# ==== BACKUP & DISASTER RECOVERY ====
BACKUP_RETENTION_DAYS=7              # Keep short (costs storage)
BACKUP_WINDOW=03:00-04:00
BACKUP_ENABLED=true
MULTI_REGION_BACKUP=false            # Not free

# ==== COST OPTIMIZATION ====
ENABLE_SPOT_INSTANCES=false          # Not stable for production
ENABLE_RESERVED_INSTANCES=false      # Free tier doesn't support
ENABLE_AUTO_SCALING=false            # Can't scale beyond 1 task
AUTO_SCALING_MIN_CAPACITY=1
AUTO_SCALING_MAX_CAPACITY=1

# ==== RESOURCE TAGS ====
TAG_PROJECT=support-triage-agent
TAG_ENVIRONMENT=production-free-tier
TAG_TEAM=platform
TAG_COST_CENTER=poc
TAG_OWNER=devops
TAG_CREATED_BY=terraform
TAG_CREATED_DATE=2026-10-12

# ==== DEPLOYMENT CONFIGURATION ====
ENABLE_CANARY_DEPLOYMENT=false       # Use basic blue/green
DEPLOYMENT_STRATEGY=blue-green
DEPLOYMENT_WAIT_TIME_SECONDS=300

# ==== SECURITY SETTINGS ====
ENABLE_SECRETS_ROTATION=false        # Complexity for free tier
ENABLE_AUDIT_LOGGING=true
ENABLE_COMPLIANCE_SCANNING=false

# ==== DATA TRANSFER LIMITS ====
# Free tier: 100 GB/month outbound data transfer
# Monitor with CloudWatch metrics
MONTHLY_DATA_TRANSFER_LIMIT_GB=100
ALERT_ON_DATA_TRANSFER_THRESHOLD_PERCENT=80

# ==== REGION CONSTRAINT ====
# New AWS Experience (Project-based): All resources must be in ap-southeast-2
# Cannot create resources in other regions
# Multi-region deployments not supported
FORCE_REGION=ap-southeast-2
ALLOW_CROSS_REGION=false

# ==== FREE TIER LIMITS MONITORING ====
# Alert when approaching free tier limits
MONITOR_RDS_STORAGE_USED_PERCENT=75  # Alert at 15 GB of 20 GB
MONITOR_ECS_CPU_PERCENT=80
MONITOR_ECS_MEMORY_PERCENT=90
MONITOR_DATABASE_CONNECTIONS=100     # t3.micro limit

# ==== CREATED: 2026-10-12 ====
# ==== FOR: Support Triage Agent Free Tier Deployment ====
# ==== REGION: ap-southeast-2 (Australia Sydney) ====
