# Production Environment Configuration Template
# Copy to .env.production and fill with actual values
# NEVER commit .env.production to git (add to .gitignore)

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
AWS_PROFILE=default  # AWS CLI profile to use

# Application Environment
ENVIRONMENT=production
APP_NAME=support-triage-agent
VERSION=v1.0
DEBUG=false
LOG_LEVEL=INFO

# Database Configuration (RDS PostgreSQL)
DB_ENGINE=postgresql
DB_VERSION=15
DB_INSTANCE_CLASS=db.t3.medium
DB_STORAGE_GB=100
DB_STORAGE_TYPE=gp3
DB_MULTI_AZ=true
DB_BACKUP_RETENTION_DAYS=30
DB_PREFERRED_BACKUP_WINDOW=03:00-04:00
DB_MAINTENANCE_WINDOW=mon:04:00-mon:05:00
DB_ENABLE_CLOUWATCH_LOGS=true
DB_ENABLE_PERFORMANCE_INSIGHTS=true

# Database Credentials (set by Terraform/Secrets Manager, not in .env)
# DB_HOST=support-triage-db.xxxxx.us-east-1.rds.amazonaws.com
# DB_PORT=5432
# DB_NAME=triage_production
# DB_USER=triage_admin
# DB_PASSWORD=<generated-secure-password>

# Redis/ElastiCache Configuration
CACHE_ENGINE=redis
CACHE_VERSION=7.0
CACHE_NODE_TYPE=cache.t3.micro
CACHE_NUM_NODES=3
CACHE_MULTI_AZ=true
CACHE_AUTOMATIC_FAILOVER=true
CACHE_AUTO_MINOR_VERSION_UPGRADE=false

# Redis Credentials (set by Terraform/Secrets Manager, not in .env)
# REDIS_HOST=support-triage-redis.xxxxx.ng.0001.use1.cache.amazonaws.com
# REDIS_PORT=6379
# REDIS_AUTH_TOKEN=<generated-secure-token>
# REDIS_DB=0
# REDIS_SSL=true

# ECS Configuration
ECS_CLUSTER_NAME=support-triage-prod
ECS_CONTAINER_CPU=512
ECS_CONTAINER_MEMORY=1024
ECS_DESIRED_COUNT=3
ECS_ENABLE_CONTAINER_INSIGHTS=true

# ALB Configuration
ALB_NAME=support-triage-alb
ALB_SCHEME=internet-facing
ALB_PORT=443
ALB_PROTOCOL=HTTPS
ALB_ENABLE_HTTP2=true
ALB_ENABLE_DELETION_PROTECTION=true

# SSL Certificate (from AWS Certificate Manager)
SSL_CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# VPC Configuration
VPC_CIDR=10.0.0.0/16
VPC_ENABLE_DNS_HOSTNAMES=true
VPC_ENABLE_DNS_SUPPORT=true

# Subnet Configuration
PRIVATE_SUBNET_1_CIDR=10.0.1.0/24
PRIVATE_SUBNET_2_CIDR=10.0.2.0/24
PRIVATE_SUBNET_3_CIDR=10.0.3.0/24
PUBLIC_SUBNET_1_CIDR=10.0.101.0/24
PUBLIC_SUBNET_2_CIDR=10.0.102.0/24
PUBLIC_SUBNET_3_CIDR=10.0.103.0/24

# Security Configuration
ENABLE_WAF=true
ENABLE_SHIELD_ADVANCED=false
ENABLE_NETWORK_ACL=true

# Monitoring & Alerts
ENABLE_CLOUDWATCH_MONITORING=true
ENABLE_ENHANCED_MONITORING=true
MONITORING_RETENTION_DAYS=30
ALERT_EMAIL=ops-team@example.com
ALERT_SNS_TOPIC=support-triage-alerts

# PagerDuty Integration
PAGERDUTY_INTEGRATION_KEY=<your-pagerduty-integration-key>
PAGERDUTY_ENABLED=true

# Slack Integration
SLACK_WEBHOOK_URL=<your-slack-webhook-url>
SLACK_CHANNEL=#support-triage-alerts
SLACK_ENABLED=true

# Application-Specific Settings
API_PORT=8000
WORKER_CONCURRENCY=4
WORKER_QUEUES=default,priority,scheduled

# Feature Flags
FEATURE_AI_TRIAGE=true
FEATURE_SENTIMENT_ANALYSIS=true
FEATURE_ESCALATION_WORKFLOWS=true
FEATURE_SLA_TRACKING=true

# Backup & Disaster Recovery
BACKUP_RETENTION_DAYS=30
BACKUP_WINDOW=03:00-04:00
BACKUP_ENABLED=true
MULTI_REGION_BACKUP=false

# Cost Optimization
ENABLE_SPOT_INSTANCES=false
ENABLE_RESERVED_INSTANCES=true
ENABLE_AUTO_SCALING=true
AUTO_SCALING_MIN_CAPACITY=2
AUTO_SCALING_MAX_CAPACITY=10
AUTO_SCALING_TARGET_CPU=70

# Tags for Resource Management
TAG_PROJECT=support-triage-agent
TAG_ENVIRONMENT=production
TAG_TEAM=platform
TAG_COST_CENTER=engineering
TAG_OWNER=devops-team@example.com

# Deployment Configuration
ENABLE_CANARY_DEPLOYMENT=true
CANARY_INITIAL_TRAFFIC_PERCENT=5
DEPLOYMENT_STRATEGY=canary
DEPLOYMENT_WAIT_TIME_BETWEEN_STAGES=1800  # 30 minutes

# Security Settings
ENABLE_ENCRYPTION_AT_REST=true
ENCRYPTION_KEY_ROTATION_DAYS=90
ENABLE_ENCRYPTION_IN_TRANSIT=true
ENABLE_SECRETS_ROTATION=true
SECRETS_ROTATION_DAYS=60

# Compliance & Audit
ENABLE_AUDIT_LOGGING=true
ENABLE_COMPLIANCE_SCANNING=true
COMPLIANCE_STANDARDS=pci-dss,hipaa,gdpr
AUDIT_LOG_RETENTION_DAYS=365

# Disaster Recovery
RTO_HOURS=1  # Recovery Time Objective
RPO_MINUTES=15  # Recovery Point Objective
ENABLE_DISASTER_RECOVERY_PLAN=true
