# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DB=triage
PG_USER=postgres
PG_PASSWORD=postgres_dev
DATABASE_URL=postgresql://postgres:postgres_dev@localhost:5432/triage

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=http://localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Mailpit (Email testing)
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# Langfuse (LLM tracing)
LANGFUSE_PORT=3000
LANGFUSE_SECRET=dev_secret_key_do_not_use_in_prod
LANGFUSE_PUBLIC_KEY=pk_dev_test
LANGFUSE_SECRET_KEY=sk_dev_test

# LiteLLM (LLM proxy)
LITELLM_PORT=8000
LITELLM_API_KEY=sk_dev_test_key
LITELLM_LOG=DEBUG

# Application
ENVIRONMENT=local
LOG_LEVEL=DEBUG
DEBUG=true

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=triage-agent

# Sprint 4 — Anomaly Detection
ANOMALY_EWMA_ALPHA=0.15
ANOMALY_ISOLATION_CONTAMINATION=0.1
ANOMALY_WEBHOOK_URL=http://localhost:8000/internal/escalation/webhook

# Sprint 4 — Escalation SLA
SLA_P0_MINUTES=15
SLA_P1_MINUTES=60
SLA_P2_MINUTES=240
SLA_P3_MINUTES=1440
SLA_GRACE_MINUTES=5

# Sprint 4 — Multi-Channel
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx
SLACK_ESCALATION_CHANNEL=#escalations
SLACK_AGENT_ID_MAPPING={}
PAGERDUTY_API_KEY=
PAGERDUTY_SERVICE_ID=
PAGERDUTY_ESCALATION_POLICY_ID=
ONCALL_ROTATION_SYNC_INTERVAL=3600

# Sprint 4 — Email
SENDGRID_API_KEY=
ESCALATION_QUEUE_EMAIL=escalations@company.com

# Sprint 4 — Webhooks
ESCALATION_WEBHOOK_URL=
ESCALATION_WEBHOOK_SECRET=

# Sprint 4 — Prometheus
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_metrics
METRICS_NAMESPACE=triage
