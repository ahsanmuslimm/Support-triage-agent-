# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DB=triage
PG_USER=postgres
PG_PASSWORD=postgres_dev
DATABASE_URL=postgresql://postgres:postgres_dev@localhost:5432/triage

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=http://localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Mailpit (Email testing)
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# Langfuse (LLM tracing)
LANGFUSE_PORT=3000
LANGFUSE_SECRET=dev_secret_key_do_not_use_in_prod
LANGFUSE_PUBLIC_KEY=pk_dev_test
LANGFUSE_SECRET_KEY=sk_dev_test

# LiteLLM (LLM proxy)
LITELLM_PORT=8000
LITELLM_API_KEY=sk_dev_test_key
LITELLM_LOG=DEBUG

# Application
ENVIRONMENT=local
LOG_LEVEL=DEBUG
DEBUG=true

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=triage-agent
